[purpleair]
api_key = YOUR_PURPLEAIR_API_KEY
sensor_id = YOUR_SENSOR_ID

# Optional. Used to fetch fallback temperature/humidity from Open-Meteo
# (no API key required) when the PurpleAir sensor drops those fields.
# Defaults to Campbell, CA 95008 if this section is omitted.
[weather]
latitude = 37.2872
longitude = -121.9500
