[purpleair]
# api_key can also be supplied via the PURPLEAIR_API_KEY environment variable,
# which takes precedence over this file. Useful for keeping the secret out of
# the repo dir — e.g. systemd EnvironmentFile= pointing at a 0600 file.
api_key = YOUR_PURPLEAIR_API_KEY
sensor_id = YOUR_SENSOR_ID

# Optional. If the PurpleAir sensor stops reporting temperature or humidity,
# these coords are used to pull a fallback reading from Open-Meteo (no key
# required). Omit the section to disable the fallback.
[weather]
latitude = 37.2872
longitude = -121.9500

# Optional. City name shown in the e-ink title bar ("Air Quality - <city>").
# Defaults to "Campbell" if omitted.
[display]
city = Campbell
