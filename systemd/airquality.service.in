[Unit]
Description=Air Quality Monitor (PurpleAir to e-ink display)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
WorkingDirectory=@REPO_DIR@
ExecStart=@PYTHON@ @REPO_DIR@/airQuality.py
Environment=AIRQUALITY_STATE_DIR=@STATE_DIR@
TimeoutStartSec=120
# No Restart= here on purpose: the timer is the retry mechanism. A
# cached-fallback run still exits 1 (so journalctl/monitoring can see
# the outage), and we don't want systemd to relaunch every 30s on top
# of the 30-min timer tick.

# Sandboxing — kept minimal because RPi.GPIO/spidev need /dev access.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=@STATE_DIR@
# Defense-in-depth: cap memory so a Pillow/requests leak can't OOM the Pi,
# constrain the personality (no 32-bit on 64-bit Pi etc.), and only allow
# the address families we actually use. AF_NETLINK stays for sysfs-backed
# SPI/GPIO to keep working — drop it if you confirm your hardware path
# doesn't touch netlink.
MemoryMax=128M
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
